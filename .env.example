# Servidor TURN do Metered (Garante conexão caso a operadora aplique CGNAT)
# Obtenha suas credenciais gratuitas em https://www.metered.ca/tools/openrelay/
VITE_METERED_TURN_URL=turn:standard.relay.metered.ca:80
VITE_METERED_TURNS_URL=turns:standard.relay.metered.ca:443?transport=tcp
VITE_METERED_USERNAME=seu_username_aqui
VITE_METERED_CREDENTIAL=sua_credential_aqui

